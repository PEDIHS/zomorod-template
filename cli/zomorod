#!/usr/bin/env bash
set -Eeuo pipefail

REPO="PEDIHS/zomorod-template"
API="https://api.github.com/repos/${REPO}/commits/main"

usage() {
  cat <<'EOF'
Zomorod command

Usage:
  sudo zomorod update          Resolve latest main commit and apply that exact snapshot
  zomorod version              Show locally installed plugin version
  zomorod status               Show installed files and integration status
EOF
}

run_root() {
  if [[ ${EUID} -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

resolve_main_sha() {
  local json
  json="$(curl -fsSL --connect-timeout 20 --max-time 60 --retry 3 --retry-delay 2 \
    -H 'Accept: application/vnd.github+json' \
    -H 'Cache-Control: no-cache' \
    "${API}?t=$(date +%s)")" || return 1
  python3 -c 'import json,sys; d=json.load(sys.stdin); s=d.get("sha",""); print(s if len(s)==40 else "")' <<<"$json"
}

reactivate_persistence_guard() {
  command -v systemctl >/dev/null 2>&1 || return 0
  run_root systemctl daemon-reload >/dev/null 2>&1 || true
  run_root systemctl enable zomorod-integrator.timer >/dev/null 2>&1 || true
  run_root systemctl restart zomorod-integrator.timer >/dev/null 2>&1 || true
  run_root systemctl restart zomorod-integrator.service >/dev/null 2>&1 || true
}

case "${1:-}" in
  update)
    shift
    command -v curl >/dev/null 2>&1 || { echo '[Zomorod] curl is required' >&2; exit 1; }
    command -v python3 >/dev/null 2>&1 || { echo '[Zomorod] python3 is required' >&2; exit 1; }
    tmp="$(mktemp /tmp/zomorod-update.XXXXXX.sh)"
    trap 'rm -f "$tmp"' EXIT

    echo "[Zomorod] resolving latest main commit..."
    sha="$(resolve_main_sha)"
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo '[Zomorod] could not resolve latest main SHA' >&2; exit 1; }
    echo "[Zomorod] latest commit: $sha"

    raw="https://raw.githubusercontent.com/${REPO}/${sha}/install.sh"
    curl -fL --show-error --connect-timeout 20 --max-time 120 --retry 3 --retry-delay 2 \
      "$raw" -o "$tmp"
    grep -q 'Zomorod Template + Special Plugin installer' "$tmp" || { echo '[Zomorod] invalid installer received' >&2; exit 1; }

    # Pin every file downloaded by the installer to the same immutable commit.
    sed -i "s/^SOURCE_REF=\"main\"$/SOURCE_REF=\"${sha}\"/" "$tmp"
    grep -q "^SOURCE_REF=\"${sha}\"$" "$tmp" || { echo '[Zomorod] could not pin installer source ref' >&2; exit 1; }

    echo "[Zomorod] applying immutable snapshot..."
    run_root bash "$tmp" "$@"

    # The official PasarGuard restart may replace the container. Re-arm the
    # host-level guard immediately so dashboard plugins are injected again into
    # the new container without waiting for the periodic timer.
    reactivate_persistence_guard

    echo "[Zomorod] update finished at commit $sha. Persistent integration guard is active."
    ;;
  version)
    file="/opt/zomorod/plugin/zomorod-special.js"
    [[ -f "$file" ]] || { echo 'Zomorod is not installed'; exit 1; }
    grep -m1 "const VERSION" "$file" | sed -E "s/.*'([^']+)'.*/Zomorod \\1/"
    ;;
  status)
    echo "Zomorod root: /opt/zomorod"
    test -s /opt/zomorod/plugin/zomorod-special.js && echo 'Plugin: installed' || echo 'Plugin: missing'
    test -s /opt/zomorod/backend/zomorod_admin_subscriptions.py && echo 'Admin namespaces backend: installed' || echo 'Admin namespaces backend: missing'
    test -s /var/lib/pasarguard/templates/subscription/index.html && echo 'Subscription template: installed' || echo 'Subscription template: missing'
    if command -v systemctl >/dev/null 2>&1; then
      systemctl is-active zomorod-integrator.service >/dev/null 2>&1 && echo 'Persistence guard: active' || echo 'Persistence guard: inactive'
      systemctl is-enabled zomorod-integrator.timer >/dev/null 2>&1 && echo 'Self-heal timer: enabled' || echo 'Self-heal timer: not enabled'
    fi
    ;;
  -h|--help|help|'') usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
