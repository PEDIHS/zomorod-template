[Unit]
Description=Persistent Zomorod/HS reintegration after PasarGuard container lifecycle changes
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/zomorod/plugin/persistence-watch.sh
Restart=always
RestartSec=2s
User=root
Group=root

[Install]
WantedBy=multi-user.target
