[Unit]
Description=Resource-bounded Zomorod reconciliation for PasarGuard
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/zomorod/plugin/integrate-dashboard.sh
TimeoutStartSec=90s
Nice=10
IOSchedulingClass=idle
CPUAccounting=true
CPUQuota=15%
CPUWeight=10
MemoryAccounting=true
MemoryHigh=128M
MemoryMax=192M
TasksMax=32
User=root
Group=root
