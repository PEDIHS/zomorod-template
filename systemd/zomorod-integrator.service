[Unit]
Description=Persistent verified Zomorod/HS integration guard for PasarGuard
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -lc 'set -u; reconcile(){ if [ -x /opt/zomorod/plugin/integrate-dashboard.sh ]; then /opt/zomorod/plugin/integrate-dashboard.sh >/dev/null 2>&1 || true; fi; if [ -x /opt/hs-pg/plugin/integrate-dashboard.sh ]; then /opt/hs-pg/plugin/integrate-dashboard.sh >/dev/null 2>&1 || true; fi; command -v docker >/dev/null 2>&1 || return 0; for cid in $(docker ps -q 2>/dev/null); do image=$(docker inspect -f "{{.Config.Image}}" "$cid" 2>/dev/null || true); case "$image" in *pasarguard/panel*) build=$(docker exec "$cid" sh -c '\''for p in /code/dashboard/build /app/dashboard/build /opt/pasarguard/dashboard/build; do [ -f "$p/index.html" ] && { echo "$p"; exit 0; }; done; f=$(find /code /app /opt -maxdepth 6 -type f -path "*/dashboard/build/index.html" -print -quit 2>/dev/null); [ -n "$f" ] && dirname "$f"'\'' 2>/dev/null || true); [ -n "$build" ] || continue; docker exec "$cid" mkdir -p "$build/statics" >/dev/null 2>&1 || true; if [ -s /opt/zomorod/plugin/zomorod-special.js ]; then docker cp /opt/zomorod/plugin/zomorod-special.js "$cid:$build/statics/zomorod-special.js" >/dev/null 2>&1 || true; for html in "$build/index.html" "$build/404.html"; do docker exec "$cid" test -f "$html" >/dev/null 2>&1 || continue; docker exec "$cid" sh -c "grep -q '\''zomorod-special-loader'\'' '\''$html'\'' || sed -i '\''s#</body>#<script id=\"zomorod-special-loader\" src=\"/statics/zomorod-special.js?v=hostguard\" defer></script></body>#'\'' '\''$html'\''" >/dev/null 2>&1 || true; done; fi; if [ -s /opt/hs-pg/plugin/hs-plugin.js ]; then docker cp /opt/hs-pg/plugin/hs-plugin.js "$cid:$build/statics/hs-plugin.js" >/dev/null 2>&1 || true; for html in "$build/index.html" "$build/404.html"; do docker exec "$cid" test -f "$html" >/dev/null 2>&1 || continue; docker exec "$cid" sh -c "grep -q '\''hs-plugin-loader'\'' '\''$html'\'' || sed -i '\''s#</body>#<script id=\"hs-plugin-loader\" src=\"/statics/hs-plugin.js?v=hostguard\" defer></script></body>#'\'' '\''$html'\''" >/dev/null 2>&1 || true; done; fi; z=skip; h=skip; if [ -s /opt/zomorod/plugin/zomorod-special.js ]; then if docker exec "$cid" test -s "$build/statics/zomorod-special.js" >/dev/null 2>&1 && docker exec "$cid" grep -q zomorod-special-loader "$build/index.html" >/dev/null 2>&1; then z=healthy; else z=missing; fi; fi; if [ -s /opt/hs-pg/plugin/hs-plugin.js ]; then if docker exec "$cid" test -s "$build/statics/hs-plugin.js" >/dev/null 2>&1 && docker exec "$cid" grep -q hs-plugin-loader "$build/index.html" >/dev/null 2>&1; then h=healthy; else h=missing; fi; fi; printf "[Plugin Guard] container=%s zomorod=%s hs=%s\n" "${cid:0:12}" "$z" "$h"; ;; esac; done; }; while true; do reconcile; sleep 10; done'
Restart=always
RestartSec=2s
User=root
Group=root

[Install]
WantedBy=multi-user.target
