[Unit]
Description=Persistent Zomorod integration guard for PasarGuard
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/zomorod/plugin/zomorod-guard.sh
Restart=always
RestartSec=3s
TimeoutStopSec=15s
User=root
Group=root

[Install]
WantedBy=multi-user.target
